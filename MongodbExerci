db.registros.updateMany(
  // 1. Filtro: Aplica a atualização apenas em documentos onde o campo seja texto
  { nome_do_filme: { $type: "string" } },
  
  // 2. Pipeline de atualização (delimitado por colchetes)
  [
    {
      $set: {
        // Remove espaços acidentais no início e no fim do nome do filme
        nome_do_filme: { $trim: { input: "$nome_do_filme" } }
      }
    },
    {
      $set: {
        // Substitui espaços duplos no meio do texto por um único espaço
        nome_do_filme: { 
          $replaceAll: { 
            input: "$nome_do_filme", 
            find: "  ", 
            replacement: " " 
